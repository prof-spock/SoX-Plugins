/**
 * @file
 * The <C>AudioDataPointRingBufferVector</C> body implements a
 * two-dimensional list of ring buffers for audio data points <I>(this
 * is the effective code include file for conditional inlining)</I>.
 *
 * @author Dr. Thomas Tensi
 * @date   2020-08
 */

/*====================*/

#include "Assertion.h"
#include "Logging.h"

/*====================*/

using Audio::AudioDataPointRingBufferVector;

/** abbreviation for StringUtil */
using STR = BaseModules::StringUtil;

/*====================*/

/** error message issued for accessing a position > 0 for a simple
 * ring buffer matrix */
static const String _ErrMsg_badPosition =
    "a simple matrix may only have one ring buffer per channel";

/*--------------------*/
/* internal routines  */
/*--------------------*/

/**
 * Returns the real index into the list for <C>channel</C> and
 * <C>position</C> also taking flag <C>hasTwoRingBuffersPerChannel</C>
 * into account.
 *
 * @param[in] hasTwoRingBuffersPerChannel  information whether one or two
 *                                         ring buffers should be used in
 *                                         the matrix
 * @param[in] channelIndex                 the index of the channel
 * @param[in] position                     the index of the data point
 *                                         in the underlying ring buffer
 * @return  index of entry in list
 */
INLINE
static Natural _effectiveIndex (IN Boolean hasTwoRingBuffersPerChannel,
                                IN Natural channelIndex,
                                IN Natural position)
{
    return (Natural{hasTwoRingBuffersPerChannel ? 2 : 1}
            * channelIndex + position);
}

/*--------------------*/
/* exported routines  */
/*--------------------*/

/*--------------------*/
/* con-/destruction   */
/*--------------------*/

INLINE
AudioDataPointRingBufferVector::AudioDataPointRingBufferVector
                              (IN Natural channelCount,
                               IN Boolean hasTwoRingBuffersPerChannel,
                               IN Natural dataPointRingBufferLength)
    : _hasTwoRingBuffersPerChannel(hasTwoRingBuffersPerChannel),
      _data{_effectiveIndex(hasTwoRingBuffersPerChannel, channelCount, 0)}
      
{
    Logging_trace(">>");
    setRingBufferLength(dataPointRingBufferLength);
    Logging_trace1("<<: %1", toString());
}

/*--------------------*/
/* property queries   */
/*--------------------*/

INLINE
Natural AudioDataPointRingBufferVector::ringBufferCount () const
{
    Logging_trace(">>");
    Natural result = _data.length();
    Logging_trace1("<<: %1", TOSTRING(result));
    return result;
}

/*--------------------*/

INLINE
Natural AudioDataPointRingBufferVector::ringBufferLength () const
{
    Natural result = (_data.length() == 0 ? 0 : _data[0].length());
    return result;
}

/*--------------------*/
/* property change    */
/*--------------------*/

INLINE
void AudioDataPointRingBufferVector::clear ()
{
    Logging_trace(">>");
    _data.clear();
    Logging_trace("<<");
}

/*--------------------*/

INLINE
void AudioDataPointRingBufferVector::setRingBufferCount (IN Natural count)
{
    Logging_trace1(">>: %1", TOSTRING(count));
    _data.setLength(count);

    for (AudioDataPointRingBuffer& ringBuffer : _data) {
        ringBuffer.setLength(0);
    }

    Logging_trace("<<");
}

/*--------------------*/

INLINE
void AudioDataPointRingBufferVector::setRingBufferLength (IN Natural length)
{
    Logging_trace1(">>: %1", TOSTRING(length));

    for (AudioDataPointRingBuffer& ringBuffer : _data) {
        ringBuffer.setLength(length);
    }

    Logging_trace("<<");
}

/*--------------------*/

INLINE
void AudioDataPointRingBufferVector::setToZero ()
{
    Logging_trace(">>");

    for (AudioDataPointRingBuffer& ringBuffer : _data) {
        ringBuffer.setToZero();
    }

    Logging_trace("<<");
}

/*--------------------*/

INLINE
const AudioDataPointRingBuffer& AudioDataPointRingBufferVector::at
                                 (IN Natural channelIndex,
                                  IN Natural position) const
{
    Assertion_pre(position == 0 || _hasTwoRingBuffersPerChannel,
                  _ErrMsg_badPosition);
    return _data[_effectiveIndex(_hasTwoRingBuffersPerChannel,
                                 channelIndex, position)];
}

/*--------------------*/

INLINE
AudioDataPointRingBuffer& AudioDataPointRingBufferVector::at
                         (IN Natural channelIndex,
                          IN Natural position)
{
    Assertion_pre(position == 0 || _hasTwoRingBuffersPerChannel,
                  _ErrMsg_badPosition);
    return _data[_effectiveIndex(_hasTwoRingBuffersPerChannel,
                                 channelIndex, position)];
}

/*--------------------*/

INLINE
AudioDataPointRingBuffer& AudioDataPointRingBufferVector::operator []
                         (IN Natural channelIndex)
{
    return at(channelIndex);
}

/*--------------------*/

INLINE void
AudioDataPointRingBufferVector::append
        (IN AudioDataPointRingBuffer& dataPointRingBuffer)
{
    Logging_trace(">>");
    _data.append(dataPointRingBuffer);
    Logging_trace("<<");
}

/*--------------------*/

INLINE
AudioDataPointRingBuffer& AudioDataPointRingBufferVector::last ()
{
    return _data.back();
}

/*--------------------*/
/* conversion         */
/*--------------------*/

INLINE String
AudioDataPointRingBufferVector::toString
    (IN Boolean dataPointDataIsShown,
     IN Natural audioFrameCount,
     IN Boolean isGroupedByFrames) const
{
    String result = "";
    const Natural channelCount = ringBufferCount();
    const Natural dataPointCount =
        Natural::minimum(audioFrameCount, ringBufferLength());

    if (!dataPointDataIsShown) {
        result = _expand("channelCount = %1, dataPointCount = %2",
                         TOSTRING(channelCount), TOSTRING(dataPointCount));
    } else {
        Natural groupCount =
            (isGroupedByFrames ? audioFrameCount : channelCount);
        Natural groupLength =
            (isGroupedByFrames ? channelCount : audioFrameCount);
    
        for (Natural i = 0; i < groupCount; i++) {
            String groupString = "(";

            for (Natural j = 0; j < groupLength; j++) {
                const AudioDataPoint& dataPoint = (isGroupedByFrames
                                                   ? _data[j][i]
                                                   : _data[i][j]);
                groupString += (j == 0 ? "" : ", ") + TOSTRING(dataPoint);
            }

            groupString += (dataPointCount < audioFrameCount ? ", ..." : "");
            groupString += ")";
            result += (result == "" ? "" : ", ") + groupString;
        }
    }

    result = STR::expand("AudioDataPointRingBufferVector(%1)", result);
    return result;
}
