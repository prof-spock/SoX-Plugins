/**
 * @file
 * The <C>WaveForm</C> body implements common services for (LFO)
 * wave forms.  The algorithms here are based on implementation ideas
 * from Carsten Borchardt and Rob Sewell in SoX file "synth.c"
 * <I>(this is the effective code include file for conditional
 * inlining)</I>.
 *
 * @author Dr. Thomas Tensi
 * @date   2020-06
 */

/*=========*/
/* IMPORTS */
/*=========*/

#include <cmath>
#include "Assertion.h"
#include "Logging.h"
#include "GenericListInterpolator.h"

/*--------------------*/

using Audio::ValuePrecision;
using Audio::WaveForm;
using Audio::WaveFormIteratorState;
using Audio::WaveFormKind;
using BaseTypes::GenericTypes::GenericListInterpolator;


/** abbreviation for StringUtil */
using STR = BaseModules::StringUtil;

/*============================================================*/

/** error message for non-positive length */
static const String _ErrMsg_badLength =
    "length must be positive";

/** error message for empty wave table */
static const String _ErrMsg_badWaveTable =     
    "wave table must be non-empty";

/*============================================================*/

namespace Audio {

    /**
     * A <C>_WaveTable</C> is just a real list storing data for a wave
     * form.
     */
    typedef RealList _WaveTable;

    /** pointer to a wave table */
    typedef _WaveTable *_WaveTablePtr;
    
    /** a position or length in the domain of a wave table */
    typedef Real _WaveTableDomainValue;
    
    /*====================*/

    /**
     * A <C>_WaveFormDescriptor</C> object contains the waveform
     * information and a cursor to it; the cursor position is
     * calculated by a linear function with start offset, step count
     * and increment instead of blindly adding up the increment: this
     * leads to no rounding runoff errors compared to the 
     * implementation.
     */
    struct _WaveFormDescriptor {

        /** the kind of waveform (sine or triangle) */
        WaveFormKind _kind;

        /** the increment for stepping in the waveform */
        _WaveTableDomainValue _increment;

        /** the first x-position into the underlying waveform */
        _WaveTableDomainValue _firstPosition;

        /** the number of steps in the waveform so far */
        Natural _stepCount;

        /** the current (cursor) x-position into the waveform */
        _WaveTableDomainValue _position;

        /** the minimum y-value in the waveform */
        Real _minimumValue;

        /** the maximum y-value in the waveform */
        Real _maximumValue;

        /** the information what kind of values is provided by the
         * wave form */
        ValuePrecision _precision;

        /** the length of the waveform */
        Real _length;

        /** the count of underlying points in the waveform */
        Natural _waveTableLength;

        /** the data buffer for the waveform */
        _WaveTablePtr _buffer;

        /** the interpolator for the waveform */
        GenericListInterpolator<_WaveTable, Real> _interpolator;

        /*--------------------*/
        /* local routines     */
        /*--------------------*/

        /**
         * Updates position from settings in descriptor.
         */
        void _updatePosition ();

        /*--------------------*/
        /* setup              */
        /*--------------------*/

        /**
         * Updates waveform to <C>length</C> base points with a wave
         * form given by <C>kind</C>; wave form has
         * <C>minimumValue</C> and <C>maximumValue</C> as bounds;
         * <C>phase</C> specifies the offset in the waveform and
         * <C>precision</C> tells whether data has to be rounded to
         * integer or single precision; note that the length is
         * <B>real</B>, that means, albeit the internal representation
         * is an array of samples, the advance operation takes care of
         * the accumulated indexing error and corrects is as soon as
         * it exceeds one (natural) index position
         *
         * @param[in] length        the count of base points
         * @param[in] kind          the kind (sine or triangle)
         * @param[in] minimumValue  the minimum y-value in waveform
         * @param[in] maximumValue  the maximum y-value in waveform
         * @param[in] phase         the initial phase (in radians)
         * @param[in] precision     tells the precision of the
         *                          y-values in the waveform
         */
        void set (IN Real length, IN WaveFormKind kind,
                  IN Real minimumValue, IN Real maximumValue,
                  IN Radians phase, IN ValuePrecision precision);

        /*--------------------*/
        /* property access    */
        /*--------------------*/

        /**
         * Returns value of waveform at <C>relativePosition</C>
         * relative to current waveform pointer (with possible
         * subsequent value transformation).
         *
         * @param[in] relativePosition  position relative to current
         *                              pointer
         * @return value of waveform at current position
         */
        Real at (IN Real relativePosition) const;

        /*--------------------*/

        /**
         * Returns current value of wave form.
         *
         * @return value of waveform at current pointer
         */
        Real current () const;

        /*--------------------*/

        /**
         * Returns length of waveform.
         *
         * @return length of waveform
         */
        Real length () const;

        /*--------------------*/
        /* change             */
        /*--------------------*/

        /**
         * Resets access to wave form to its beginning
         */
        void reset ();
        
        /*--------------------*/

        /**
         * Sets state of iteration in wave form.
         *
         * @param[in] state  new state of wave form
         */
        void setState (WaveFormIteratorState state);

        /*--------------------*/

        /**
         * Advances access to wave form to next sample position
         * (taking into account an accumulated indexing error because
         * of a non-natural waveform length)
         */
        void advance ();

        /*--------------------*/
        /* conversion         */
        /*--------------------*/

        /**
         * Returns raw string representation of descriptor.
         *
         * @return string representation without type wrapping
         */
        String asRawString () const;

    };

    /*====================*/

}

/*============================================================*/

using Audio::_WaveTable;
using Audio::_WaveTableDomainValue;
using Audio::_WaveFormDescriptor;

/*============================================================*/

extern _WaveTable _sineWaveTable;
extern _WaveTable _triangleWaveTable;

/*============================================================*/

/*=====================*/
/* _WaveFormDescriptor */
/*=====================*/

/*--------------------*/
/* local routines     */
/*--------------------*/

INLINE
void _WaveFormDescriptor::_updatePosition ()
{
    _WaveTableDomainValue p =
        _firstPosition + _WaveTableDomainValue{_stepCount} * _increment;
    _position = _WaveTableDomainValue::mod(p, _waveTableLength);
}

/*--------------------*/
/* setup              */
/*--------------------*/

INLINE
void _WaveFormDescriptor::set (IN Real length, IN WaveFormKind kind,
                               IN Real minimumValue, IN Real maximumValue,
                               IN Radians phase,
                               IN ValuePrecision precision)
{
    Logging_trace6(">>: length = %1, kind = %2,"
                   " minimumValue = %3, maximumValue = %4,"
                   " phase = %5, precision = %6",
                   TOSTRING(length), waveFormKindToString(kind),
                   TOSTRING(minimumValue), TOSTRING(maximumValue),
                   TOSTRING(phase), valuePrecisionToString(precision));
    Assertion_pre(length > 0.0, _ErrMsg_badLength);

    _WaveTablePtr buffer = (kind == WaveFormKind::sine
                            ? &_sineWaveTable
                            : &_triangleWaveTable);
    const Natural interpolationOrder =
        (kind == WaveFormKind::sine ? 3 : 1);
    const Natural waveTableLength = buffer->length();
    Assertion_pre(waveTableLength > 0, _ErrMsg_badWaveTable);

    const _WaveTableDomainValue firstPosition =
        _WaveTableDomainValue::mod((_WaveTableDomainValue) waveTableLength
                                   * phase / Real::twoPi,
                                   (_WaveTableDomainValue) waveTableLength);

    _kind             = kind;
    _firstPosition    = firstPosition;
    _increment        = (_WaveTableDomainValue) waveTableLength / length;
    _stepCount        = 0;
    _position         = firstPosition;
    _minimumValue     = minimumValue;
    _maximumValue     = maximumValue;
    _precision        = precision;
    _length           = length;
    _waveTableLength  = waveTableLength;
    _buffer           = buffer;

    _interpolator.set(*buffer, _waveTableLength, _waveTableLength,
                      interpolationOrder);

    Logging_trace("<<");
}

/*--------------------*/
/* property access    */
/*--------------------*/

INLINE
Real _WaveFormDescriptor::at (IN Real relativePosition) const
{
    _WaveTableDomainValue positionInWaveTable =
        _position + relativePosition * _increment;

    while (positionInWaveTable < 0.0) {
        positionInWaveTable += _waveTableLength;
    }
    
    Real value = _interpolator.at(positionInWaveTable);
    const Real scalingFactor = _maximumValue - _minimumValue;
    value = _minimumValue + value * scalingFactor;

    /* the following does not distribute integer values equally over
       their range: the minimum and maximum value only get 50%
       coverage of all the other values */
    value = (_precision == ValuePrecision::doublePrecision
             ? value
             : (_precision == ValuePrecision::integerPrecision
                ? value.round()
                : value.toSinglePrecision()));
    return value;
}

/*--------------------*/

INLINE
Real _WaveFormDescriptor::current () const
{
    return at(0.0);
}

/*--------------------*/

INLINE
Real _WaveFormDescriptor::length () const
{
    return _length;
}

/*--------------------*/
/* change             */
/*--------------------*/

INLINE
void _WaveFormDescriptor::reset ()
{
    _stepCount = 0;
    _position  = _firstPosition;
}

/*--------------------*/

INLINE
void _WaveFormDescriptor::setState (WaveFormIteratorState state)
{
    _stepCount = state;
    _updatePosition();
}

/*--------------------*/

INLINE
void _WaveFormDescriptor::advance ()
{
    _stepCount++;
    _updatePosition();
}

/*--------------------*/
/* conversion         */
/*--------------------*/

INLINE
String _WaveFormDescriptor::asRawString () const
{
    String result=
        STR::expand("kind = %1, firstPosition = %2,"
                    " increment = %3, stepcount = %4,"
                    " position = %5, minimumValue = %6,"
                    " maximumValue = %7, precision = %8,"
                    " length = %9, waveTableLength = %A, buffer = %B",
                    waveFormKindToString(_kind), TOSTRING(_firstPosition),
                    TOSTRING(_increment), TOSTRING(_stepCount),
                    TOSTRING(_position), TOSTRING(_minimumValue),
                    TOSTRING(_maximumValue),
                    valuePrecisionToString(_precision),
                    TOSTRING(_length), TOSTRING(_waveTableLength),
                    _buffer->toString());
    return result;
}

/*============================================================*/

/*--------------------*/
/* auxiliary routines */
/*--------------------*/

INLINE
WaveFormKind Audio::stringToWaveFormKind (IN String& st)
{
    return (STR::toLowercase(st) == "triangle"
            ? WaveFormKind::triangle : WaveFormKind::sine);
}

/*--------------------*/

INLINE
String Audio::valuePrecisionToString (IN ValuePrecision precision)
{
    return String((precision == ValuePrecision::doublePrecision
                   ? "double"
                   : (precision == ValuePrecision::integerPrecision
                      ? "integer" : "single")));
}

/*--------------------*/

INLINE
String Audio::waveFormKindToString (IN WaveFormKind kind)
{
    return String(kind == WaveFormKind::sine
                  ? "sine" : "triangle");
}

/*--------------------*/
/* con-/destruction   */
/*--------------------*/

INLINE
WaveForm::WaveForm ()
{
    Logging_trace(">>");

    _descriptor = new _WaveFormDescriptor{};
    set(10.0, WaveFormKind::triangle, 0.0, 1.0, 0.0,
        ValuePrecision::singlePrecision);

    Logging_trace1("<<: %1", toString());
}

/*--------------------*/

INLINE
WaveForm::WaveForm (IN WaveForm& otherWaveForm)
{
    Logging_trace1(">>: %1", otherWaveForm.toString());

    _descriptor = new _WaveFormDescriptor{};
    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    const _WaveFormDescriptor& other =
        TOREFERENCE<_WaveFormDescriptor>(otherWaveForm._descriptor);
    descriptor = other;
    
    Logging_trace1("<<: %1", toString());
}

/*--------------------*/

INLINE
WaveForm::~WaveForm ()
{
    Logging_trace(">>");
    _WaveFormDescriptor* descriptor =
        (_WaveFormDescriptor*) _descriptor;
    delete descriptor;
    Logging_trace("<<");
}

/*--------------------*/
/* assignment         */
/*--------------------*/

INLINE
WaveForm& WaveForm::operator= (WaveForm& otherWaveForm)
{
    Logging_trace1(">>: %1", otherWaveForm.toString());

    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    const _WaveFormDescriptor& other =
        TOREFERENCE<_WaveFormDescriptor>(otherWaveForm._descriptor);
    descriptor = other;
    
    Logging_trace1("<<: %1", toString());
    return *this;
}

/*--------------------*/
/* conversion         */
/*--------------------*/

INLINE
String WaveForm::toString () const {
    const _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);

    String result = "WaveForm(" + descriptor.asRawString() + ")";

    return result;
}

/*--------------------*/
/* setup              */
/*--------------------*/

INLINE
void WaveForm::set (IN Real length, IN WaveFormKind kind,
                    IN Real minimumValue, IN Real maximumValue,
                    IN Radians phase, IN ValuePrecision precision)
{
    Logging_trace6(">>: length = %1, kind = %2,"
                   " minimumValue = %3, maximumValue = %4,"
                   " phase = %5, precision = %6",
                   TOSTRING(length), waveFormKindToString(kind),
                   TOSTRING(minimumValue), TOSTRING(maximumValue),
                   TOSTRING(phase), valuePrecisionToString(precision));
    Assertion_pre(length > 0.0, _ErrMsg_badLength);

    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    descriptor.set(length, kind, minimumValue, maximumValue,
                   phase, precision);

    Logging_trace1("<<: %1", toString());
}

/*--------------------*/
/* property access    */
/*--------------------*/

INLINE
Real WaveForm::at (IN Real position) const
{
    const _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    return descriptor.at(position);
}

/*--------------------*/

INLINE
Real WaveForm::current () const
{
    const _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    return descriptor.current();
}

/*--------------------*/

INLINE
Real WaveForm::length () const
{
    const _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    return descriptor.length();
}

/*--------------------*/

INLINE
WaveFormIteratorState WaveForm::state () const
{
    const _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    return descriptor._stepCount;
}

/*--------------------*/
/* property change    */
/*--------------------*/

INLINE
void WaveForm::reset ()
{
    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    descriptor.reset();
}

/*--------------------*/

INLINE
void WaveForm::setState (WaveFormIteratorState state)
{
    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    descriptor.setState(state);
}

/*--------------------*/

INLINE
void WaveForm::advance ()
{
    _WaveFormDescriptor& descriptor =
        TOREFERENCE<_WaveFormDescriptor>(_descriptor);
    descriptor.advance();
}

/*--------------------*/
/* time lock service  */
/*--------------------*/

INLINE
Radians WaveForm::phaseByTime (IN Real frequency,
                               IN Real timeOffset,
                               IN Real currentTime)
{
    Logging_trace3(">>: frequency = %1, timeOffset = %2,"
                   " currentTime = %3",
                   TOSTRING(frequency), TOSTRING(timeOffset),
                   TOSTRING(currentTime));

    Radians result;
    const Real deltaTime = currentTime - timeOffset;
    result = Real::fractionalPart(deltaTime * frequency) * Real::twoPi;
    result = result.mod(Real::twoPi);

    Logging_trace1("<<: %1", TOSTRING(result));
    return result;
}
